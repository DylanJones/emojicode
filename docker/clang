FROM ubuntu:24.04

ENV CC=clang-20
ENV CXX=clang++-20
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONIOENCODING=utf8

RUN \
  apt-get update \
  && apt-get install -y --no-install-recommends \
    clang-20 \
    cmake \
    libzstd-dev \
    llvm-20-dev \
    ninja-build \
    python3 \
    rsync \
    zlib1g-dev \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir /build

WORKDIR /build

COPY . /build/

RUN \
  cmake . -GNinja -DLLVM_DIR=/usr/lib/llvm-20/lib/cmake/llvm \
  && ninja \
  && ninja magicinstall

CMD ["ninja", "tests"]
