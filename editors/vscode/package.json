{
  "name": "emojicode",
  "displayName": "Emojicode",
  "description": "Emojicode language support: highlighting, errors, hover, go to definition, completion and links to the documentation for learners",
  "version": "0.1.0",
  "publisher": "emojicode",
  "license": "Artistic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DylanJones/emojicode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "emojicode",
        "aliases": [
          "Emojicode",
          "emojicode"
        ],
        "extensions": [
          ".emojic",
          ".🍇",
          ".emojii"
        ],
        "filenames": [
          "🏛"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "emojicode",
        "scopeName": "source.emojicode",
        "path": "./syntaxes/emojicode.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Emojicode",
      "properties": {
        "emojicode.server.path": {
          "type": "string",
          "default": "emojicode-lsp",
          "description": "Path to the emojicode-lsp language server. Leave it as emojicode-lsp to look it up on the PATH."
        },
        "emojicode.packageSearchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional directories to search for packages, like the compiler's -S option."
        },
        "emojicode.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between VS Code and the language server to the Emojicode output channel."
        },
        "emojicode.learnerDocs.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Link code to the section of the Emojicode documentation that explains it when you hover over it, e.g. 🔂 to *For In* or 😀 to its page in the `s` package. Toggle it with **Emojicode: Toggle Learner Docs** or the status bar."
        },
        "emojicode.learnerDocs.baseUrl": {
          "type": "string",
          "default": "https://www.emojicode.org/",
          "markdownDescription": "The root of the documentation website that learner docs link to. Set it to `http://localhost:8080/` to use the documentation's `./serve`."
        }
      }
    },
    "configurationDefaults": {
      "[emojicode]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.unicodeHighlight.allowedCharacters": {
          "️": true,
          "➕": true,
          "➖": true
        }
      }
    },
    "commands": [
      {
        "command": "emojicode.toggleLearnerDocs",
        "title": "Toggle Learner Docs",
        "category": "Emojicode"
      },
      {
        "command": "emojicode.openLearnerDocs",
        "title": "Open Documentation for Token at Cursor",
        "category": "Emojicode",
        "enablement": "editorLangId == emojicode"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node test/grammar.test.js && node test/learnerDocs.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
