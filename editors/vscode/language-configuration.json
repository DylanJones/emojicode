{
  "comments": {
    "lineComment": "💭",
    "blockComment": ["💭🔜", "🔚💭"]
  },
  "brackets": [
    ["🍇", "🍉"],
    ["🤜", "🤛"],
    ["🐚", "🍆"],
    ["🍿", "🍆"]
  ],
  "surroundingPairs": [
    ["🍇", "🍉"],
    ["🤜", "🤛"],
    ["🐚", "🍆"],
    ["🍿", "🍆"],
    ["🔤", "🔤"]
  ],
  "folding": {
    "markers": {
      "start": "^.*🍇(?!.*🍉)",
      "end": "^\\s*🍉"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*🍇(?!.*🍉)",
    "decreaseIndentPattern": "^\\s*🍉"
  },
  "wordPattern": {
    "pattern": "(?:\\p{Extended_Pictographic}|[\\u{1F1E6}-\\u{1F1FF}])[\\u{FE0F}\\u{1F3FB}-\\u{1F3FF}\\u{1F1E6}-\\u{1F1FF}]*(?:[\\u{200D}🔸]\\u{FE0F}?\\p{Extended_Pictographic}[\\u{FE0F}\\u{1F3FB}-\\u{1F3FF}]*)*|[^\\s\\p{Extended_Pictographic}\\u{FE0F}\\u{200D}]+",
    "flags": "u"
  }
}
